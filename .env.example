# Copy this file to ".env" (same folder) and fill in your values.
# .env is ignored by git so your key never gets committed or shared.

# ElevenLabs → profile icon → API Keys
ELEVENLABS_API_KEY=

# ElevenLabs → Voices → your Gloop voice → "Copy Voice ID"
ELEVENLABS_VOICE_ID=

# Optional: eleven_multilingual_v2 (default, stable) or eleven_v3 (more expressive)
# ELEVENLABS_MODEL=eleven_multilingual_v2
